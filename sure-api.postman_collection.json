            "url": {
              "raw": "{{baseUrl}}/api/v1/chats/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","chats",":id"],
              "variable": [{ "key": "id", "value": "", "description": "Chat UUID" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat\": {\n    \"title\": \"Updated title\"\n  }\n}"
