        {
          "name": "Retry last assistant response",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chats/:chat_id/messages/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","chats",":chat_id","messages","retry"],
              "variable": [{ "key": "chat_id", "value": "", "description": "Chat UUID" }]
            }
