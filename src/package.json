    "transactions-savings": "tsx app/transactions.ts --account-name '32 Day Flexi Notice' --reverse --split-income-and-expenses"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
