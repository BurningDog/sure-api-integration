    {
      "name": "Holdings",
      "item": [
        {
          "name": "List holdings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/holdings",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","holdings"],
              "query": [
                { "key": "page",          "value": "1",  "description": "Page number",                        "disabled": true },
                { "key": "per_page",      "value": "25", "description": "Items per page (max 100)",            "disabled": true },
                { "key": "account_id",    "value": "",   "description": "Filter by account UUID",              "disabled": true },
                { "key": "account_ids[]", "value": "",   "description": "Filter by multiple account UUIDs",    "disabled": true },
                { "key": "date",          "value": "",   "description": "Holdings as of date (YYYY-MM-DD)",    "disabled": true },
                { "key": "start_date",    "value": "",   "description": "From date (YYYY-MM-DD)",              "disabled": true },
                { "key": "end_date",      "value": "",   "description": "To date (YYYY-MM-DD)",                "disabled": true },
                { "key": "security_id",   "value": "",   "description": "Filter by security UUID",             "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Retrieve holding",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/holdings/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","holdings",":id"],
              "variable": [{ "key": "id", "value": "", "description": "Holding UUID" }]
            }
          }
        }
      ]
    },
    {
      "name": "Imports",
