              "raw": "{\n  \"trade\": {\n    \"account_id\": \"uuid\",\n    \"security_id\": \"uuid\",\n    \"date\": \"2025-03-15\",\n    \"qty\": 10,\n    \"price\": 150.00,\n    \"currency\": \"USD\",\n    \"type\": \"buy\"\n  }\n}"
            }
