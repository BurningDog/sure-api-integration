{
  "name": "sure-api-integration",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "transactions": "tsx app/transactions.ts",
    "transactions-json": "tsx app/transactions.ts --json",
    "transactions-all": "tsx app/transactions.ts --reverse --split-income-and-expenses",
